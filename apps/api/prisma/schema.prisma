generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Brand {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  createdAt   DateTime       @default(now())
  versions    BrandVersion[]
  driftStates DriftState[]
}

// immutable, editing a brand inserts a new row with version + 1
model BrandVersion {
  id          String       @id @default(cuid())
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  version     Int
  stylePrompt String
  rules       String
  palette     String[]
  threshold   Float
  note        String?
  createdAt   DateTime     @default(now())
  generations Generation[]

  @@unique([brandId, version])
}

enum GenerationStatus {
  queued
  generating
  uploading
  checking
  done
  failed
}

enum CheckStatus {
  pending
  ok
  check_unavailable
}

model Generation {
  id                    String           @id @default(cuid())
  idempotencyKey        String?          @unique
  status                GenerationStatus @default(queued)

  brandVersionId        String
  brandVersion          BrandVersion     @relation(fields: [brandVersionId], references: [id])
  subject               String
  prompt                String
  promptTemplateVersion String

  model                 String
  seed                  Int?
  latencyMs             Int?
  costUsd               Float?
  imageKey              String?
  imageUrl              String?

  checkStatus           CheckStatus      @default(pending)
  judgeModel            String?
  judgePromptVersion    String?
  score                 Float?
  reasons               String?
  paletteMatch          Float?
  onBrand               Boolean?

  error                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  job                   Job?

  @@index([brandVersionId, createdAt])
  @@index([model, createdAt])
  @@index([status])
}

model Job {
  id           String           @id @default(cuid())
  generationId String           @unique
  generation   Generation       @relation(fields: [generationId], references: [id], onDelete: Cascade)
  status       GenerationStatus @default(queued)
  attempts     Int              @default(0)
  maxAttempts  Int              @default(3)
  runAfter     DateTime         @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lastError    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, runAfter])
}

enum DriftStatus {
  ok
  drifting
}

// one row per brand + model, remembers the last verdict so slack gets one message per change, not per image
model DriftState {
  id        String      @id @default(cuid())
  brandId   String
  brand     Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  model     String
  status    DriftStatus @default(ok)
  mean      Float?
  samples   Int         @default(0)
  changedAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([brandId, model])
}
