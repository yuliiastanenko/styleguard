PORT=8787
CORS_ORIGINS=http://localhost:5173,https://*.lovable.app,https://*.lovableproject.com
WORKER_CONCURRENCY=2
# true = run the queue worker inside the api process (single free instance)
RUN_WORKER=false
# cf-llama4-scout | cf-gemma4 | openai-gpt-4.1-mini
JUDGE_MODEL=cf-llama4-scout

# pooled (host has -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# direct, used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=styleguard
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# workers ai, uses R2_ACCOUNT_ID
CF_AI_TOKEN=

FAL_KEY=
OPENAI_API_KEY=
